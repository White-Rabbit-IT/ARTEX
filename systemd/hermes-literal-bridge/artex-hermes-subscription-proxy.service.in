[Unit]
Description=Hermes Subscription Proxy on reviewed ARTEX bridge only
Requires=artex-hermes-literal-bridge-firewall.service
BindsTo=artex-hermes-literal-bridge-firewall.service
After=artex-hermes-literal-bridge-firewall.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__HERMES_USER__
Group=__HERMES_GROUP__
Environment=HOME=__HERMES_HOME__
WorkingDirectory=__HERMES_HOME__
EnvironmentFile=/run/artex-hermes-literal-bridge/route.env
ExecStart=__HERMES_BIN__ proxy start --provider nous --host ${ARTEX_HERMES_BRIDGE_GATEWAY} --port ${ARTEX_HERMES_PROXY_PORT}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
