# REVIEW TEMPLATE ONLY. Do not install this file as a systemd unit.
# Every __PLACEHOLDER__ must be derived and reviewed on the host at activation.
[Unit]
Description=Hermes Subscription Proxy for a reviewed ARTEX bridge only
Requires=artex-hermes-proxy-firewall.service
BindsTo=artex-hermes-proxy-firewall.service
After=artex-hermes-proxy-firewall.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__HERMES_LOGIN_OWNER__
Group=__HERMES_LOGIN_OWNER__
# Do not add ProtectHome=yes: Hermes OAuth state belongs to the ordinary user.
EnvironmentFile=/run/artex-hermes-literal-bridge/route.env
ExecStart=__HERMES_BIN__ proxy start --provider nous --host ${ARTEX_HERMES_BRIDGE_GATEWAY} --port ${ARTEX_HERMES_PROXY_PORT}
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=default.target
